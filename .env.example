# ChatRPG environment configuration.
# Copy to backend/.env and fill in.

# === Server ===
HOST=127.0.0.1
PORT=8013
LOG_LEVEL=INFO

# === Database ===
DATABASE_URL=postgresql+asyncpg://chatrpg:chatrpg@127.0.0.1:54318/chatrpg

# === Single-user mode ===
# V1 assumes a single local user. Set a stable user id; everything is scoped to it.
SINGLE_USER_ID=local
SINGLE_USER_NAME=Player

# === Auth ===
# Copy auth.example.json to auth.json for local bootstrap admin credentials.
# Public deployments must set a long random JWT_SECRET.
# AUTH_FILE defaults to repo-root/auth.json; uncomment with an absolute path if needed.
# AUTH_FILE=/opt/chatrpg/auth.json
JWT_SECRET=chatrpg-dev-secret-change-me
JWT_TTL_HOURS=720

# Hosted registration is disabled by default. Enable it only for an isolated
# test deployment, preferably behind invite codes.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_REQUIRED=true
# Comma-separated raw invite codes; server stores only hashes.
REGISTRATION_INVITE_CODES=
REGISTRATION_INVITE_MAX_USES=1

# === LLM providers ===
# At least one provider must be configured. The default for new sessions
# is the first one with a key set, in this order: openai, deepseek, gemini, claude.

# OpenAI-compatible (also: DeepSeek, Kimi, GLM, Doubao, Qwen, Grok via base_url)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_DEFAULT_MODEL=moonshot-v1-32k

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_DEFAULT_MODEL=glm-4-plus

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_DEFAULT_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus

GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_DEFAULT_MODEL=grok-2

# Native API providers
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-pro

CLAUDE_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6

# === TRPG runtime ===
TRPG_DEFAULT_PROVIDER=openai
TRPG_DEFAULT_MODEL=gpt-4o
# Memory compression triggers when message count exceeds this threshold.
TRPG_MEMORY_COMPRESS_THRESHOLD=20

# === Frontend ===
FRONTEND_URL=http://localhost:3013
