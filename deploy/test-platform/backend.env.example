LOG_LEVEL=INFO
DEBUG=false
JWT_SECRET=replace-with-a-long-random-value
JWT_TTL_HOURS=720

REGISTRATION_ENABLED=true
REGISTRATION_INVITE_REQUIRED=true
REGISTRATION_INVITE_CODES=replace-with-invite-code
REGISTRATION_INVITE_MAX_USES=20

# Keep hosted smoke tests runnable without spending provider credits.
# Operators can add real provider keys later through the admin UI or env.
TRPG_DEFAULT_PROVIDER=mock
TRPG_DEFAULT_MODEL=mock-gm
